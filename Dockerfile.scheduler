# Compatibility shim: prefer `Dockerfile` target `scheduler`.
# Kept so older docs/scripts that name this file still build the drain binary.

FROM rust:1-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
RUN cargo build -p spork-server --bin spork-scheduler --release \
 && strip target/release/spork-scheduler

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates libssl3 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/spork-scheduler /usr/local/bin/spork-scheduler
ENV RUST_LOG=info
ENV SCHEDULER_INTERVAL_SECS=5
ENV DATABASE_URL=postgres://postgres:spork@postgres:5432/spork
ENTRYPOINT ["spork-scheduler"]
