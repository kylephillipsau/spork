{
  "name": "spork-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/gen-tokens.mjs",
    "tokens:check": "node scripts/gen-tokens.mjs --check",
    "laws": "node scripts/check-laws.mjs",
    "verify": "npm run typecheck && npm run test && npm run tokens:check && npm run contract && npm run laws",
    "contract": "node scripts/check-contract.mjs",
    "render": "node scripts/render.mjs",
    "build:review": "vite build --mode review --outDir dist-review",
    "build:mobile": "tsc --noEmit && vite build --mode mobile --outDir dist-mobile",
    "test": "node --test domain/*.test.ts app/nav/*.test.ts app/routing/*.test.ts app/integrity/findings/*.test.ts app/measurement/capture/*.test.ts app/outbound/picking/*.test.ts app/measurement/*.test.ts app/inbound/putaway/*.test.ts app/inbound/receiving/*.test.ts",
    "frame": "node scripts/check-frame.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
